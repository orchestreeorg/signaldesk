# Copy to .env. Never commit .env or a real BotFather token.
DATABASE_URL=postgres://signal:signal@127.0.0.1:5433/signal
REDIS_URL=redis://localhost:6379
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 1 = log only. 0 = long-poll (pnpm bot) and real send (pnpm smoke).
TELEGRAM_DRY_RUN=1
# 1 = poll RSS/Farside/mempool every 5 minutes (CoinDesk, The Block, Fed, EDGAR, Farside, large BTC txs).
NEWS_LIVE=0
# Confirmed BTC output size that becomes a Neutral headline. mempool.space Esplora, no key.
BTC_LARGE_TX_BTC=1000
MEMPOOL_API_BASE=https://mempool.space/api
# 1 = Binance USDT-M futures WS (trades/CVD, liqs, funding) + OI REST.
TAPE_LIVE=0
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional. Demo key raises CoinGecko rate limits for Overview sentiment.
COINGECKO_API_KEY=
# Optional. Raises CoinMarketCap Fear & Greed rate limits; keyless public API works without it.
CMC_API_KEY=
# Ops dashboard (pnpm dash). Same REDIS_URL. Optional gate for Start/Stop.
DASH_SECRET=
