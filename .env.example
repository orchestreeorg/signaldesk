# Copy to .env. Never commit .env or a real BotFather token.
DATABASE_URL=postgres://signal:signal@127.0.0.1:5433/signal
REDIS_URL=redis://localhost:6379
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 1 = log only. 0 = long-poll (pnpm bot) and real send (pnpm smoke).
TELEGRAM_DRY_RUN=1
# 1 = poll RSS every 5 minutes (CoinDesk, The Block, Fed, EDGAR, Farside).
NEWS_LIVE=0
# 1 = Binance USDT-M futures WS (trades/CVD, liqs, funding) + OI REST.
TAPE_LIVE=0
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Ops dashboard (pnpm dash). Same REDIS_URL. Optional gate for Start/Stop.
DASH_SECRET=
